# ═══════════════════════════════════════════════════
# EventAI — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example is tracked.
# ═══════════════════════════════════════════════════

# ── General ────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# LOG_FORMAT: json (single-line structured logs) or text (human-readable).
# Defaults to text in development and json in production when unset.
LOG_FORMAT=

# ── PostgreSQL ─────────────────────────────────────
# Host port 5433 (docker-compose maps 5433->5432 to avoid clashing with a native PostgreSQL on 5432)
DATABASE_URL=postgresql://eventai:eventai_dev@localhost:5433/eventai?schema=public

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ─────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# ── Google OAuth 2.0 (optional) ───────────────────
# Leave empty to disable "Sign in with Google" — the API returns 503 for
# /api/auth/google and the frontend buttons are the only visible hint.
# Setup guide: docs/google-oauth.md
# The redirect URI registered in Google Cloud Console must exactly match
# GOOGLE_CALLBACK_URL (default: http://localhost:4000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── Razorpay (Sandbox) ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── AI / Grok (xAI) ───────────────────────────────
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx
GROK_MODEL=grok-3
GROK_API_URL=https://api.x.ai/v1

# ── Pinecone ───────────────────────────────────────
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PINECONE_INDEX=eventai
PINECONE_ENVIRONMENT=us-east-1

# ── Resend (Email) ─────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@eventai.dev

# ── File Storage ───────────────────────────────────
# Using local uploads in dev; configure S3/Cloudinary for prod
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Seat Hold ──────────────────────────────────────
SEAT_HOLD_TTL_SECONDS=600

# ── Sentry (Optional) ─────────────────────────────
# SENTRY_DSN=https://xxxx@sentry.io/xxxx
