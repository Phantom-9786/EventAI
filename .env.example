# ═══════════════════════════════════════════════════
# EventPoint — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example is tracked.
# ═══════════════════════════════════════════════════

# ── General ────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# LOG_FORMAT: json (single-line structured logs) or text (human-readable).
# Defaults to text in development and json in production when unset.
LOG_FORMAT=

# ── PostgreSQL ─────────────────────────────────────
# Host port 5433 (docker-compose maps 5433->5432 to avoid clashing with a native PostgreSQL on 5432)
DATABASE_URL=postgresql://eventai:eventai_dev@localhost:5433/eventai?schema=public

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ─────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# ── Google OAuth 2.0 (optional) ───────────────────
# Leave empty to disable "Sign in with Google" — the API returns 503 for
# /api/auth/google and the frontend buttons are the only visible hint.
# Setup guide: docs/google-oauth.md
# The redirect URI registered in Google Cloud Console must exactly match
# GOOGLE_CALLBACK_URL (default: http://localhost:4000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── Razorpay (Sandbox) ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── AI / Groq ─────────────────────────────────────
# Groq API key (gsk_...). Create keys at https://console.groq.com/keys
# Single-key setup:
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Multi-key setup (optional): a comma-separated list. When set, it takes
# precedence over GROQ_API_KEY. Add future keys here — no code changes needed.
# Keys stay in .env only (git-ignored); never in the DB, logs, or source.
# Authentication failures (401/403) cool the credential and may rotate;
# all configured credentials share one quota pool and never rotate on 429.
# GROQ_API_KEYS=gsk_key_one_xxxxxxxxxxxxxxxxxx,gsk_key_two_xxxxxxxxxxxxxxxx
# Legacy/default model for moderate and complex requests; model access varies by project.
GROQ_MODEL=openai/gpt-oss-120b
# Simple profile defaults to a lightweight Groq-supported model. Override IDs
# below when model access differs for your project.
# GROQ_SIMPLE_MODEL=openai/gpt-oss-20b
# GROQ_MODERATE_MODEL=openai/gpt-oss-120b
# GROQ_COMPLEX_MODEL=openai/gpt-oss-120b
# AI limits are shared through Redis; AI requests fail closed if Redis is down.
AI_RATE_LIMIT_USER_PER_MINUTE=10
AI_RATE_LIMIT_GLOBAL_PER_MINUTE=120
AI_MAX_CONCURRENT_REQUESTS=20
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1400

# ── Mood-based semantic RAG ────────────────────────
# Downloads a small public pretrained model once, then embeds text locally.
# Requires the event_semantic_embeddings migration; no embedding API key.
SEMANTIC_RAG_ENABLED=true
# Optional writable model download/cache directory:
# SEMANTIC_MODEL_CACHE_DIR=/var/cache/eventai-models

# ── Brevo (Email) ──────────────────────────────────
# Brevo transactional API key (xkeysib-...). Create a verified sender in the
# Brevo dashboard (Senders & IP) and use its address in EMAIL_FROM — sends
# from an unverified sender address are rejected.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=EventPoint <verified-sender@your-domain.com>

# ── File Storage & Cloudinary ───────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Cloudinary Media Storage (Production media integration)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=eventai/events
# Operator kill switch: true to enable uploads, false to pause all uploads immediately
MEDIA_UPLOADS_ENABLED=true
# Configurable file size limit in bytes (default 5 MB: 5242880)
MEDIA_MAX_FILE_SIZE_BYTES=5242880
# Safe usage cutoff percentage (default 95)
CLOUDINARY_MAX_USAGE_PERCENT=95

# ── Rate Limiting ──────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Seat Hold ──────────────────────────────────────
SEAT_HOLD_TTL_SECONDS=600

# ── Sentry (Optional) ─────────────────────────────
# API error monitoring. Create a Node.js project at https://sentry.io and copy
# its DSN here. Leave unset to keep monitoring disabled (fully graceful).
# SENTRY_DSN=https://example.ingest.sentry.io/1234567
# Human-readable environment tag shown in Sentry (e.g. development|staging|production)
# SENTRY_ENVIRONMENT=development
# Optional: release identifier and tracing sample rate (default 0.1)
# SENTRY_RELEASE=eventai-api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Web (Next.js) error monitoring — set these in apps/web/.env.local:
# NEXT_PUBLIC_SENTRY_DSN=https://example.ingest.sentry.io/7654321
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional (build-time source-map upload, CI only):
# SENTRY_ORG=your-org
# SENTRY_PROJECT=eventai-web
# SENTRY_AUTH_TOKEN=sntrys_yourtoken
